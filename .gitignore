.env
.venv/
storage/
__pycache__/
*.pyc
.pytest_cache/
.coverage
.DS_Store

# Harness runs write a decision log per run; the JSON reports beside them are
# committed on purpose, because the report quotes from them.
evaluation/results/*.db
evaluation/results/*.db-wal
evaluation/results/*.db-shm

# The decision log is a runtime artefact. It accumulates across runs into the
# output directory, so re-running the harness into the same folder grows it
# without bound - the 500-ticket database reached 16MB during development.
# The readable export beside it, decision_log.jsonl, is the auditable artefact
# and that one is committed.
evaluation/results/**/*.db
evaluation/results/**/*.db-wal
evaluation/results/**/*.db-shm

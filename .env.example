# Copy to .env and fill in what you need. Every variable here has a working
# default in src/config.py, so the system runs with none of them set - it just
# runs without a model provider, which is a supported mode.

# --- model provider ---------------------------------------------------
# Leave the key empty to run entirely on the extractive path.
OPENROUTER_API_KEY=
MODEL_NAME=meta-llama/llama-3.1-8b-instruct
# Set to "offline" to force the degraded path. This is what CI uses.
PROVIDER=
PROVIDER_TIMEOUT=25
PROVIDER_MAX_RETRIES=3
# Cache completions on disk under STORAGE_PATH. 0 disables it.
PROVIDER_CACHE=1

# --- retrieval --------------------------------------------------------
# lexical (default) or dense; dense needs requirements-dense.txt.
RETRIEVAL_BACKEND=lexical
RETRIEVAL_TOP_K=5
# BM25 score below which a passage is treated as noise. See ADR-002.
RETRIEVAL_FLOOR=4.2

# --- routing thresholds -----------------------------------------------
CONFIDENCE_THRESHOLD=0.62
# Higher bar for the classes where a wrong answer is expensive.
HIGH_COST_THRESHOLD=0.85

# --- paths ------------------------------------------------------------
CORPUS_PATH=data/documentation.json
MODEL_PATH=models/intent_classifier.json
STORAGE_PATH=storage
DATABASE_URL=sqlite:///./storage/decisions.db

# --- operations -------------------------------------------------------
LOG_LEVEL=INFO
METRICS_PORT=8001
# Creating this file halts automatic responses. See docs/incident_response.md.
KILL_SWITCH_PATH=storage/HALT
# Shared secret for POST /admin/halt and /admin/resume. Unset means those
# endpoints refuse rather than run open.
ADMIN_TOKEN=change-me
